# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend STL
NEXT_PUBLIC_BACKEND_URL=https://teu-backend.com

# URL da app (usado nos emails)
NEXT_PUBLIC_APP_URL=https://makerpro.pt

# PP3D Studio — app separada de foto->campanha (link no menu de administração)
NEXT_PUBLIC_STUDIO_URL=https://pp3d-studio.vercel.app

# Cron (Vercel Cron Jobs) — gera um valor aleatório longo ex: openssl rand -hex 32
CRON_SECRET=um_valor_secreto_longo_e_aleatorio

# Resend (email newsletters) — obtém em resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Email verificado no Resend. Em testes podes usar: onboarding@resend.dev
RESEND_FROM_EMAIL=MakerPro <noreply@makerpro.pt>

# Meta (Instagram/Facebook) — publicação orgânica. Ver docs/plano-marketing.md
# para o passo a passo de setup (Meta App em modo Development chega, gratuito).
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
# Só necessário para a parte paga (impulsionar / Meta Ads). Requer Ad Account
# com método de pagamento configurado no Meta Business Manager.
META_AD_ACCOUNT_ID=

# Assistente de IA do admin (chat com contexto real da loja) — Google Gemini,
# tier gratuito, sem cartão de crédito. Obtém a chave em aistudio.google.com/apikey
GEMINI_API_KEY=
